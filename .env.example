# Defina como "true" para exibir participantes de demonstração nos relatórios.
# Por padrão o app usa apenas dados reais (compras e participantes sincronizados).
NEXT_PUBLIC_DEMO_MODE=false

# Obrigatório em produção — use uma string longa e aleatória (mín. 32 caracteres).
AUTH_SECRET=change-me-to-a-long-random-secret
